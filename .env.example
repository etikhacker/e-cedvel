# Staging setup: docs/STAGING.md. Do not copy production project credentials.
# Used only by scripts/check-staging-env.mjs (not a Supabase runtime setting).
STAGING_SUPABASE_PROJECT_REF=YOUR_STAGING_PROJECT_REF
# Public browser configuration. Prefer the staging publishable key, never a secret key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_STAGING_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Case-sensitive existing bucket name. Live schema audited with "Materials".
NEXT_PUBLIC_MATERIALS_BUCKET=Materials

# Server-only: staging secret key or legacy service_role from the SAME staging project.
# Variable names are retained for compatibility with the existing application.
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVER_ONLY_SECRET_KEY
RESEND_API_KEY=YOUR_STAGING_RESEND_API_KEY
RESEND_FROM_EMAIL=E-Cedvel <invites@YOUR_VERIFIED_DOMAIN>
# Delivery provider defaults to resend. Use smtp when no verified Resend domain exists.
MAIL_PROVIDER=resend
# SMTP alternative (server-only); set MAIL_PROVIDER=smtp and fill these instead of Resend.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=YOUR_GMAIL_ADDRESS
# SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
# SMTP_FROM_EMAIL=E-Cedvel <YOUR_GMAIL_ADDRESS>
# Auth SMTP credentials belong in Supabase Dashboard, not this Next.js env file.
# Application SMTP credentials are a separate server configuration; never expose them publicly.
# DATABASE_URL, a database password and SUPABASE_ACCESS_TOKEN are not app requirements.
