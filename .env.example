# Public browser configuration. Use the project's anon/publishable key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Case-sensitive existing bucket name. Live schema audited with "Materials".
NEXT_PUBLIC_MATERIALS_BUCKET=Materials

# Server-only: set in Vercel environment variables, never in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=E-Cedvel <invites@YOUR_VERIFIED_DOMAIN>
